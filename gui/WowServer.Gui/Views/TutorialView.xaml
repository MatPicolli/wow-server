<UserControl x:Class="WowServer.Gui.Views.TutorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Como funciona" Style="{StaticResource Titulo}" />
            <TextBlock Style="{StaticResource Subtitulo}"
                       Text="Um servidor de WoW são duas coisas: um programa que você compila e os dados de mapa que saem do seu próprio client. Este programa cuida das duas. Leia na ordem — cada passo depende do anterior." />

            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Antes de começar" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}">
                        Você precisa de um client de WoW <Run Foreground="#E4E7EF" FontWeight="SemiBold">3.3.5a, build 12340</Run>
                        já instalado. Reserve umas 3 horas no total e cerca de 90 GB de disco.
                        Boa parte desse tempo é o computador trabalhando sozinho — dá pra deixar rodando e sair.
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel x:Name="Passos" />

            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,10,0,24">
                <StackPanel>
                    <TextBlock Text="Se algo der errado" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,8">
                        Nenhuma etapa estraga o que já foi feito: todas detectam o que está pronto e pulam.
                        Pode fechar o programa no meio e retomar depois.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}">
                        A primeira mensagem de erro é a que importa — o compilador despeja centenas de linhas
                        depois dela. O arquivo docs/troubleshooting.md tem os casos mais comuns.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
