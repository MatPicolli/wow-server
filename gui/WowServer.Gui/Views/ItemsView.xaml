<UserControl x:Class="WowServer.Gui.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Itens" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Procura no item_template do seu banco. Marque quantos quiser e mande de uma vez, por correio ou pelo chat do jogo. Passe o mouse em cima para ver os detalhes." />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Left" Text="Nome" VerticalAlignment="Center"
                                   Margin="0,0,4,0" FontSize="12" />
                        <v:HelpIcon DockPanel.Dock="Left" Chave="item.nome" Margin="0,0,8,0" />
                        <TextBox x:Name="CaixaNome" KeyDown="Nome_KeyDown" />
                    </DockPanel>
                    <Button Grid.Column="2" Content="Procurar" Style="{StaticResource BotaoPrincipal}"
                            Click="Procurar_Click" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Categoria" FontSize="11"
                                   Foreground="{StaticResource TextDim}" />
                        <ComboBox x:Name="ComboClasse" SelectionChanged="Classe_Changed" />
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Tipo" FontSize="11"
                                   Foreground="{StaticResource TextDim}" />
                        <ComboBox x:Name="ComboSubclasse" />
                    </DockPanel>

                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="Qualidade" FontSize="11"
                                   Foreground="{StaticResource TextDim}" />
                        <ComboBox x:Name="ComboQualidade" />
                    </DockPanel>

                    <DockPanel Grid.Column="6">
                        <TextBlock DockPanel.Dock="Top" Text="Nível do item" FontSize="11"
                                   Foreground="{StaticResource TextDim}" />
                        <DockPanel>
                            <v:HelpIcon DockPanel.Dock="Right" Chave="item.nivel" />
                            <TextBox x:Name="CaixaNivelMin" Width="42" />
                            <TextBlock Text="a" Margin="4,0" VerticalAlignment="Center" FontSize="11" />
                            <TextBox x:Name="CaixaNivelMax" Width="42" />
                        </DockPanel>
                    </DockPanel>
                </Grid>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="TxtResumo" DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextDim}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Extrair ícones" Padding="8,3" FontSize="11" Click="ExtrairIcones_Click"
                                ToolTip="Lê os ícones dos MPQ do seu WoW e grava como PNG. Roda uma vez só." />
                        <Button Content="Marcar todos" Padding="8,3" FontSize="11" Click="MarcarTodos_Click" />
                        <Button Content="Desmarcar" Padding="8,3" FontSize="11" Click="Desmarcar_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Lista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,3"
                                    MouseEnter="Item_MouseEnter" Tag="{Binding Entry}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Marcado, Mode=TwoWay}" />

                                    <!-- Quadrado na cor da qualidade no lugar do
                                         icone do jogo: os icones sao BLP dentro
                                         dos MPQ do client, que a instalacao nao
                                         extrai. Ver o comentario em ItemsView.xaml.cs. -->
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="3"
                                            Margin="0,0,8,0" BorderThickness="2"
                                            BorderBrush="{Binding CorQualidade}"
                                            Background="{StaticResource BgConsole}">
                                        <Grid>
                                            <Image Source="{Binding Icone}" Width="22" Height="22"
                                                   Visibility="{Binding VisibilidadeIcone}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Inicial}" FontSize="12" FontWeight="Bold"
                                                       Visibility="{Binding VisibilidadeLetra}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding CorQualidade}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NivelTexto}"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextDim}" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontSize="13"
                                                   Foreground="{Binding CorQualidade}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" FontSize="10"
                                                   Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                        MinHeight="220">
                    <StackPanel x:Name="PainelBalao" />
                </Border>

                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Enviar os marcados" FontWeight="SemiBold" FontSize="13"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Personagem" VerticalAlignment="Center"
                                       Margin="0,0,4,0" FontSize="12" />
                            <v:HelpIcon DockPanel.Dock="Left" Chave="cmd.personagem" Margin="0,0,8,0" />
                            <TextBox x:Name="CaixaPersonagem" />
                        </DockPanel>
                        <Button Content="Mandar por correio" Style="{StaticResource BotaoPrincipal}"
                                Click="Correio_Click" Margin="0,0,0,6"
                                ToolTip="Usa 'send items' no console. Não precisa do personagem online." />
                        <Button Content="Copiar comandos .additem" Click="CopiarAddItem_Click"
                                ToolTip="Para colar no chat do jogo: vai direto para a bolsa de quem estiver selecionado." />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextDim}"
                                   Text="O correio aceita 12 itens por carta, então a lista é dividida em várias. O .additem depende de quem está selecionado no jogo, por isso não funciona pelo console." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <v:ConsolePane x:Name="Saida" />
        </DockPanel>
    </Grid>
</UserControl>
