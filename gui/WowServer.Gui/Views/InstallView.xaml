<UserControl x:Class="WowServer.Gui.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Instalação" Style="{StaticResource Titulo}" />
            <TextBlock Style="{StaticResource Subtitulo}"
                       Text="Cada etapa pode ser executada isoladamente e pode ser repetida sem estragar nada — o que já está pronto é detectado e pulado. A extração dos dados do client é a demorada." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="BtnTudo" Content="Instalar tudo" Style="{StaticResource BotaoPrincipal}"
                    Click="Tudo_Click" />
            <Button x:Name="BtnParar" Content="Parar" Click="Parar_Click" IsEnabled="False" />
            <Button Content="Limpar console" Click="Limpar_Click" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaEtapas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Marcador}" FontSize="15" Width="24"
                                                   Foreground="{Binding CorMarcador}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Duracao}" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Descricao}" Foreground="{StaticResource TextDim}"
                                               FontSize="12" TextWrapping="Wrap" Margin="24,6,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <Button Content="Executar" Padding="10,4" FontSize="12"
                                                Tag="{Binding Id}" Click="Etapa_Click" />
                                        <TextBlock Text="requer administrador" FontSize="11"
                                                   Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                                                   Visibility="{Binding VisibilidadeAdmin}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <v:ConsolePane x:Name="Saida" Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
