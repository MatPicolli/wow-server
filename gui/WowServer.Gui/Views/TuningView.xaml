<UserControl x:Class="WowServer.Gui.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Ajustes de jogo" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Multiplicadores aplicados sobre os valores originais, que ficam guardados. Aplicar 3x duas vezes continua sendo 3x, e dá pra voltar ao original a qualquer momento." />

                <GroupBox Header="Perfis prontos">
                    <StackPanel x:Name="Perfis" />
                </GroupBox>

                <GroupBox Header="Quanto vem de cada coleta">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Mineração" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtMining" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Herbalismo" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtHerb" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Pesca" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtFish" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Esfolamento" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtSkin" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Desencantar" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtDisench" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Moagem" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtMill" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Prospecção" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.multiplicador" />
                            </StackPanel>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtProsp" Text="1" Margin="0,3" />
                        </Grid>
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="1 = sem alteração. O teto por item é 255 (limite do banco); valores muito altos são limitados e o preview avisa." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Chance de drop">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Itens de quest" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.quest" />
                            </StackPanel>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtQuest" Text="1" Margin="0,3" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Loot comum de criatura" VerticalAlignment="Center" />
                                <v:HelpIcon Chave="tune.creature" />
                            </StackPanel>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtCreature" Text="1" Margin="0,3" />
                        </Grid>
                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="Chance é porcentagem, limitada a 100. Itens de quest resolvem o clássico 'mate 10 e colete 3'. Mexer no loot comum afeta o jogo inteiro." />
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button Content="Ver o que mudaria" Click="Preview_Click" />
                    <Button Content="Aplicar" Style="{StaticResource BotaoPrincipal}" Click="Aplicar_Click" />
                    <Button Content="Restaurar original" Click="Reset_Click" />
                </StackPanel>

                <!-- Ajustes do worldserver.conf. Sao outra coisa: nao mexem no
                     banco, e so valem depois de reiniciar o servidor. Por isso
                     tem lista, botoes e aviso proprios. -->
                <TextBlock Text="Ajustes do servidor" Style="{StaticResource Titulo}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Estes ficam no worldserver.conf, não no banco. Valem quando o servidor for reiniciado. Cada linha mostra o valor que está no arquivo agora, em dourado quando já foi mexido. Deixe a caixa em branco para não alterar aquela chave." />

                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Filtrar" VerticalAlignment="Center"
                               Margin="0,0,4,0" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <v:HelpIcon DockPanel.Dock="Left" Chave="cfg.filtro" Margin="0,0,8,0" />
                    <TextBox x:Name="CaixaFiltroConf" TextChanged="FiltroConf_Changed" />
                </DockPanel>

                <ItemsControl x:Name="ListaConf">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="70" Margin="8,0,0,0"
                                             Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <v:HelpIcon DockPanel.Dock="Right" Entrada="{Binding Ajuda}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Rotulo}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{Binding CorDetalhe}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
                    <Button Content="Ver o que mudaria" Click="PreviewConf_Click" />
                    <Button Content="Aplicar no servidor" Style="{StaticResource BotaoPrincipal}"
                            Click="AplicarConf_Click" />
                    <Button Content="Restaurar original" Click="ResetConf_Click" />
                    <Button Content="Ver valores atuais" Click="ListarConf_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <v:ConsolePane x:Name="Saida" Grid.Column="2" />
    </Grid>
</UserControl>
