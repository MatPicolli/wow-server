<UserControl x:Class="WowServer.Gui.Views.ItemCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Criar itens" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Monta a linha do item_template e gera o SQL. Nada vai para o banco sem você conferir antes: o botão Aplicar mostra o comando, faz backup e só então grava." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="O básico">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Nome" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.nome" />
                                        <TextBox x:Name="TxtNome" TextChanged="Texto_Changed" />
                                    </DockPanel>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="ID (entry)" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.entry" />
                                        <TextBox x:Name="TxtEntry" TextChanged="Texto_Changed" />
                                    </DockPanel>
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Para que serve" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.tipo" />
                                        <ComboBox x:Name="ComboTipo" SelectionChanged="Tipo_Changed">
                                            <ComboBox.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </DockPanel>
                                </DockPanel>

                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Slot" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.slot" />
                                        <ComboBox x:Name="ComboSlot" SelectionChanged="Selecao_Changed">
                                            <ComboBox.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </DockPanel>
                                </DockPanel>

                                <DockPanel Grid.Column="4">
                                    <TextBlock DockPanel.Dock="Top" Text="Qualidade" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.qualidade" />
                                        <ComboBox x:Name="ComboQualidade" SelectionChanged="Selecao_Changed">
                                            <ComboBox.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Nível do item" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <TextBox x:Name="TxtItemLevel" TextChanged="Texto_Changed" />
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Nível necessário" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <TextBox x:Name="TxtReqLevel" TextChanged="Texto_Changed" />
                                </DockPanel>
                                <DockPanel Grid.Column="4">
                                    <TextBlock DockPanel.Dock="Top" Text="Pilha máxima" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <TextBox x:Name="TxtPilha" TextChanged="Texto_Changed" />
                                </DockPanel>
                                <DockPanel Grid.Column="6">
                                    <TextBlock DockPanel.Dock="Top" Text="Vínculo" FontSize="11"
                                               Foreground="{StaticResource TextDim}" />
                                    <DockPanel>
                                        <v:HelpIcon DockPanel.Dock="Right" Chave="novo.vinculo" />
                                        <ComboBox x:Name="ComboVinculo" SelectionChanged="Selecao_Changed">
                                            <ComboBox.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Descrição (o texto dourado do balão)"
                                           FontSize="11" Foreground="{StaticResource TextDim}" />
                                <TextBox x:Name="TxtDescricao" TextChanged="Texto_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Ícone">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Os ícones vêm da extração feita na aba Itens. Se a lista estiver vazia, rode 'Extrair ícones' lá primeiro." />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Procurar" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource TextDim}" />
                                <TextBlock x:Name="TxtIconeEscolhido" DockPanel.Dock="Right"
                                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{StaticResource Accent}" />
                                <TextBox x:Name="CaixaIcone" TextChanged="FiltroIcone_Changed" />
                            </DockPanel>
                            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ListaIcones">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="40" Height="40" Margin="2" CornerRadius="3"
                                                    BorderThickness="2" BorderBrush="{Binding CorBorda}"
                                                    Background="{StaticResource BgConsole}"
                                                    Tag="{Binding DisplayId}"
                                                    MouseLeftButtonUp="Icone_Click"
                                                    ToolTip="{Binding Dica}">
                                                <Image Source="{Binding Imagem}" Width="34" Height="34"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Atributos">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Até 10. Deixe o valor em zero para não usar a linha." />
                            <ItemsControl x:Name="ListaAtributos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBox DockPanel.Dock="Right" Width="70" Margin="8,0,0,0"
                                                     Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox ItemsSource="{Binding Tipos}"
                                                      SelectedIndex="{Binding TipoIndice, Mode=TwoWay}">
                                                <ComboBox.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Atualizar prévia" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Padding="10,4" FontSize="12" Click="Campo_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Combate e resistência">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Armadura" FontSize="11"
                                           Foreground="{StaticResource TextDim}" />
                                <TextBox x:Name="TxtArmadura" TextChanged="Texto_Changed" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Dano mín." FontSize="11"
                                           Foreground="{StaticResource TextDim}" />
                                <TextBox x:Name="TxtDanoMin" TextChanged="Texto_Changed" />
                            </DockPanel>
                            <DockPanel Grid.Column="4">
                                <TextBlock DockPanel.Dock="Top" Text="Dano máx." FontSize="11"
                                           Foreground="{StaticResource TextDim}" />
                                <TextBox x:Name="TxtDanoMax" TextChanged="Texto_Changed" />
                            </DockPanel>
                            <DockPanel Grid.Column="6">
                                <TextBlock DockPanel.Dock="Top" Text="Velocidade (ms)" FontSize="11"
                                           Foreground="{StaticResource TextDim}" />
                                <DockPanel>
                                    <v:HelpIcon DockPanel.Dock="Right" Chave="novo.delay" />
                                    <TextBox x:Name="TxtDelay" TextChanged="Texto_Changed" />
                                </DockPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="8">
                                <TextBlock DockPanel.Dock="Top" Text="Durabilidade" FontSize="11"
                                           Foreground="{StaticResource TextDim}" />
                                <TextBox x:Name="TxtDurabilidade" TextChanged="Texto_Changed" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Efeitos — magias, buffs e auras">
                        <StackPanel>
                            <Border Background="#2A241A" BorderBrush="{StaticResource Warn}"
                                    BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource Warn}"
                                           Text="Um buff ou aura NOVO não pode ser criado pelo servidor: o efeito, o nome e o ícone de toda magia moram no Spell.dbc, que é do cliente. O que dá para fazer aqui — e funciona sem mexer no cliente — é pendurar no item uma magia que já existe no jogo. Procure abaixo pelo nome." />
                            </Border>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Procurar magia" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource TextDim}" />
                                <v:HelpIcon DockPanel.Dock="Left" Chave="novo.magia" Margin="0,0,8,0" />
                                <Button DockPanel.Dock="Right" Content="Procurar" Padding="10,4" FontSize="12"
                                        Click="ProcurarMagia_Click" />
                                <TextBox x:Name="CaixaMagia" KeyDown="Magia_KeyDown" />
                            </DockPanel>

                            <ScrollViewer x:Name="RolagemMagias" Height="120" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                <ItemsControl x:Name="ListaMagias">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,3"
                                                    Tag="{Binding Id}" MouseLeftButtonUp="Magia_Click">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Width="60"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource TextDim}" />
                                                    <TextBlock Text="{Binding Nome}" FontSize="12" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ItemsControl x:Name="ListaEfeitos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBox DockPanel.Dock="Left" Width="80" Margin="0,0,8,0"
                                                     Text="{Binding SpellId, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="ID da magia no Spell.dbc" />
                                            <TextBox DockPanel.Dock="Right" Width="70" Margin="8,0,0,0"
                                                     Text="{Binding Cooldown, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Recarga em milissegundos. -1 = sem recarga própria." />
                                            <ComboBox ItemsSource="{Binding Gatilhos}"
                                                      SelectedIndex="{Binding GatilhoIndice, Mode=TwoWay}">
                                                <ComboBox.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Atualizar prévia" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Padding="10,4" FontSize="12" Click="Campo_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Colunas à mão (para o que não cabe acima)">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Uma por linha, no formato coluna = valor. Vale qualquer coluna do item_template: ScalingStatDistribution = 61, socketColor_1 = 2, ScriptName = 'meu_script'. Coluna que não existir no seu banco é descartada com aviso, em vez de derrubar o INSERT." />
                            <DockPanel>
                                <v:HelpIcon DockPanel.Dock="Right" Chave="novo.extra" VerticalAlignment="Top" />
                                <TextBox x:Name="TxtExtra" Height="80" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                         TextChanged="Texto_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                        <Button Content="Ver o SQL" Click="VerSql_Click" />
                        <Button Content="Aplicar no banco" Style="{StaticResource BotaoPrincipal}"
                                Click="Aplicar_Click" />
                        <Button Content="Salvar .sql" Click="SalvarSql_Click" />
                        <Button Content="Sugerir um ID livre" Click="SugerirId_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                        MinHeight="180">
                    <StackPanel x:Name="PainelBalao" />
                </Border>

                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Conferência" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <ItemsControl x:Name="ListaProblemas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <v:ConsolePane x:Name="Saida" />
        </DockPanel>
    </Grid>
</UserControl>
