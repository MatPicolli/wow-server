<UserControl x:Class="WowServer.Gui.Views.ConsolePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource BgConsole}"
            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
        <DockPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                <DockPanel>
                    <Ellipse x:Name="Indicador" Width="8" Height="8" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{StaticResource TextDim}" />
                    <TextBlock x:Name="Titulo" Text="Console" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkQuebrar" Content="quebrar linha" IsChecked="True"
                                  FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Checked="Quebrar_Changed" Unchecked="Quebrar_Changed" />
                        <TextBlock x:Name="Estado"
                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                   VerticalAlignment="Center" Text="parado" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barra de comando: so aparece nos consoles que aceitam entrada
                 (o worldserver). E por aqui que vao os comandos de GM. -->
            <Border x:Name="BarraComando" DockPanel.Dock="Bottom" Visibility="Collapsed"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Enviar" Margin="8,0,0,0"
                            Click="Enviar_Click" />
                    <TextBox x:Name="CaixaComando" FontFamily="Consolas"
                             KeyDown="CaixaComando_KeyDown"
                             ToolTip="Comandos do servidor, sem o ponto. Ex.: account create nome senha" />
                </DockPanel>
            </Border>

            <!-- HorizontalScrollBarVisibility=Disabled nao e so estetica: e ela
                 que faz o item ser limitado a largura do viewport, sem isso o
                 TextWrapping do TextBlock nao teria contra o que quebrar. -->
            <ListBox x:Name="Linhas" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Cor}"
                                   FontFamily="Consolas" FontSize="12" Padding="10,0"
                                   TextWrapping="{Binding Quebra,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>
    </Border>
</UserControl>
