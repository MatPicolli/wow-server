<UserControl x:Class="WowServer.Gui.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Comandos de GM" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Comandos marcados como 'console' o programa envia direto ao servidor. Os marcados como 'no jogo' dependem de quem está selecionado ou de onde você está, então precisam do chat — copie e cole lá, com o ponto na frente." />

                <!-- Kit de heranca: o motivo mais provavel de alguem abrir esta
                     tela. Os IDs saem do banco, nunca de uma lista fixa. -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Kit de herança completo" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" FontSize="12"
                                   Foreground="{StaticResource TextDim}"
                                   Text="Envia pelo correio todos os itens de herança que existem no seu banco. A lista sai de uma consulta, não de IDs escritos à mão, então inclui o que os seus módulos tenham acrescentado. Chega em cartas de 12 itens." />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Personagem" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontSize="12" />
                            <Button DockPanel.Dock="Right" Content="Enviar" Margin="8,0,0,0"
                                    Click="Heranca_Click" />
                            <Button DockPanel.Dock="Right" Content="Ver o que existe" Margin="8,0,0,0"
                                    Click="HerancaListar_Click"
                                    ToolTip="Só lista os itens de herança do banco, sem enviar nada" />
                            <TextBox x:Name="CaixaPersonagem"
                                     ToolTip="O nome exato do personagem que vai receber as cartas" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Filtrar" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <TextBox x:Name="CaixaFiltro" TextChanged="Filtro_Changed"
                             ToolTip="Filtra por nome ou descrição. Ex.: conta, item, teleporte" />
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Lista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,2"
                                                Background="{Binding CorSelo}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Selo}" FontSize="10" Foreground="#12141A"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="14" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Categoria}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextDim}" />

                                    <TextBlock Text="{Binding Descricao}" Margin="0,6,0,8" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{StaticResource TextDim}" />

                                    <Border Background="{StaticResource BgConsole}" CornerRadius="3"
                                            Padding="8,5" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding TextoExibido}" FontFamily="Consolas"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Accent}" />
                                    </Border>

                                    <TextBlock Text="{Binding AvisoPreencher}" TextWrapping="Wrap"
                                               FontSize="11" Margin="0,0,0,8"
                                               Foreground="{StaticResource Warn}"
                                               Visibility="{Binding VisibilidadeAviso}" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Copiar" Padding="10,4" FontSize="12"
                                                Tag="{Binding Titulo}" Click="Copiar_Click" />
                                        <Button Content="Enviar ao servidor" Padding="10,4" FontSize="12"
                                                Tag="{Binding Titulo}" Click="Enviar_Click"
                                                Visibility="{Binding VisibilidadeEnviar}"
                                                ToolTip="Manda direto para o console do worldserver, que precisa estar ligado" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <v:ConsolePane x:Name="Saida" Grid.Column="2" />
    </Grid>
</UserControl>
