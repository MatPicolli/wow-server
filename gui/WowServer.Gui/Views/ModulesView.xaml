<UserControl x:Class="WowServer.Gui.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WowServer.Gui.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Módulos" Style="{StaticResource Titulo}" />
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Instalar um módulo clona o repositório e recompila. O SQL que ele traz é aplicado sozinho no próximo start do servidor." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Recompilar" Click="Rebuild_Click"
                            ToolTip="Refaz build, deploy e configuração. Use depois de instalar ou atualizar módulos." />
                    <Button Content="Atualizar instalados" Click="Atualizar_Click" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Lista">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,2"
                                                Background="{Binding CorSelo}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Selo}" FontSize="10" Foreground="#12141A"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="14" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Resumo}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detalhes}" Foreground="{StaticResource TextDim}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding TextoBotao}" Padding="10,4" FontSize="12"
                                                Tag="{Binding Nome}" Click="Instalar_Click"
                                                IsEnabled="{Binding PodeInstalar}" />
                                        <Button Content="Abrir no navegador" Padding="10,4" FontSize="12"
                                                Tag="{Binding Repositorio}" Click="Abrir_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <v:ConsolePane x:Name="Saida" Grid.Column="2" />
    </Grid>
</UserControl>
