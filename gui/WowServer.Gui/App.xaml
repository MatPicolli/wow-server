<Application x:Class="WowServer.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Paleta escura, proxima do tom do proprio jogo -->
        <SolidColorBrush x:Key="Bg"        Color="#12141A" />
        <SolidColorBrush x:Key="BgPanel"   Color="#1A1D26" />
        <SolidColorBrush x:Key="BgConsole" Color="#0C0E13" />
        <SolidColorBrush x:Key="Border"    Color="#2A2F3D" />
        <SolidColorBrush x:Key="Text"      Color="#E4E7EF" />
        <SolidColorBrush x:Key="TextDim"   Color="#8B93A7" />
        <SolidColorBrush x:Key="Accent"    Color="#C8A44D" />
        <SolidColorBrush x:Key="Ok"        Color="#5FB878" />
        <SolidColorBrush x:Key="Warn"      Color="#D9A441" />
        <SolidColorBrush x:Key="Err"       Color="#E06C6C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize"   Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="{StaticResource TextDim}" />
            <Setter Property="FontSize"      Value="13" />
            <Setter Property="TextWrapping"  Value="Wrap" />
            <Setter Property="Margin"        Value="0,0,0,16" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource BgPanel}" />
            <Setter Property="Foreground"    Value="{StaticResource Text}" />
            <Setter Property="BorderBrush"   Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"       Value="14,7" />
            <Setter Property="Margin"        Value="0,0,8,0" />
            <Setter Property="Cursor"        Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="{StaticResource Accent}" />
            <Setter Property="Foreground"  Value="#12141A" />
            <Setter Property="FontWeight"  Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgConsole}" />
            <Setter Property="Foreground"      Value="{StaticResource Text}" />
            <Setter Property="BorderBrush"     Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="7,5" />
            <Setter Property="CaretBrush"      Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin"     Value="0,4" />
        </Style>

        <!-- ComboBox com template proprio.

             As duas tentativas anteriores mexeram na cor da letra e deixaram o
             desenho padrao do Windows no lugar. Nao resolveu: o template padrao
             traz o proprio fundo CLARO, e a cor da letra que a gente controla
             nao alcanca todas as partes dele - sobrava letra clara em fundo
             claro em algum canto (a caixa fechada, a lista, ou o item sob o
             mouse, dependendo do tema do Windows).

             Com template proprio nao ha fundo herdado de ninguem: cada parte -
             caixa, seta, popup, item normal, item sob o mouse, item selecionado
             - tem cor explicita, do mesmo tema escuro do resto do programa.
             Deixa de depender de qual tema o Windows esta usando. -->
        <SolidColorBrush x:Key="TextoCombo" Color="#E4E7EF" />

        <Style x:Key="TextoEmCombo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoCombo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextoCombo}" />
            <Setter Property="Padding"    Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="fundo" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Todos os estados com fundo ESCURO, e a letra
                                 clara sempre. Um destaque dourado exigiria
                                 trocar a letra para escura junto, e a letra do
                                 item vem de um estilo de TextBlock, que ganha de
                                 cor herdada - o par se separaria e voltaria o
                                 claro-no-claro. Estado escuro nao tem esse
                                 risco: a mesma letra serve para todos. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#2A3346" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="fundo" Property="Background" Value="#39456180" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{StaticResource TextoCombo}" />
            <Setter Property="Background"      Value="{StaticResource BgConsole}" />
            <Setter Property="BorderBrush"     Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="7,5" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment"   Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton ocupando a caixa toda: e o que
                                 abre e fecha a lista. Sem ele o clique nao
                                 faz nada. -->
                            <ToggleButton x:Name="parteClicavel"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="caixa"
                                                Background="{StaticResource BgConsole}"
                                                BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path x:Name="seta" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,9,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource TextDim}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="caixa" Property="BorderBrush"
                                                        Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- O texto do item escolhido. IsHitTestVisible
                                 False para o clique atravessar e chegar no
                                 ToggleButton de tras. -->
                            <ContentPresenter x:Name="textoEscolhido"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource BgPanel}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-abas de Extras: em cima, horizontais. Estilo proprio pelo mesmo
             motivo do ComboBox - o desenho padrao do Windows traz fundo claro,
             e num tema escuro isso aparece como retangulo branco. -->
        <Style x:Key="SubAba" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="raiz" Background="Transparent" Padding="16,9" Margin="0,0,4,0"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#1A1D26" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#1A1D26" />
                                <Setter TargetName="raiz" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
