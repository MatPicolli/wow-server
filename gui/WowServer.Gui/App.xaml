<Application x:Class="WowServer.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Paleta escura, proxima do tom do proprio jogo -->
        <SolidColorBrush x:Key="Bg"        Color="#12141A" />
        <SolidColorBrush x:Key="BgPanel"   Color="#1A1D26" />
        <SolidColorBrush x:Key="BgConsole" Color="#0C0E13" />
        <SolidColorBrush x:Key="Border"    Color="#2A2F3D" />
        <SolidColorBrush x:Key="Text"      Color="#E4E7EF" />
        <SolidColorBrush x:Key="TextDim"   Color="#8B93A7" />
        <SolidColorBrush x:Key="Accent"    Color="#C8A44D" />
        <SolidColorBrush x:Key="Ok"        Color="#5FB878" />
        <SolidColorBrush x:Key="Warn"      Color="#D9A441" />
        <SolidColorBrush x:Key="Err"       Color="#E06C6C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize"   Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="{StaticResource TextDim}" />
            <Setter Property="FontSize"      Value="13" />
            <Setter Property="TextWrapping"  Value="Wrap" />
            <Setter Property="Margin"        Value="0,0,0,16" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource BgPanel}" />
            <Setter Property="Foreground"    Value="{StaticResource Text}" />
            <Setter Property="BorderBrush"   Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"       Value="14,7" />
            <Setter Property="Margin"        Value="0,0,8,0" />
            <Setter Property="Cursor"        Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="{StaticResource Accent}" />
            <Setter Property="Foreground"  Value="#12141A" />
            <Setter Property="FontWeight"  Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgConsole}" />
            <Setter Property="Foreground"      Value="{StaticResource Text}" />
            <Setter Property="BorderBrush"     Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="7,5" />
            <Setter Property="CaretBrush"      Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin"     Value="0,4" />
        </Style>

        <!-- O ComboBox continua com o desenho padrao do Windows, que tem fundo
             CLARO. O estilo implicito de TextBlock ali em cima pinta a letra de
             quase branco, e ele alcanca tambem os TextBlock que o proprio
             template do ComboBox cria para mostrar o texto - o resultado era
             letra clara em fundo claro, ilegivel na caixa e na lista aberta.

             Estilo de TextBlock ganha de cor herdada, entao mandar so o
             Foreground do ComboBox nao resolve: e preciso trocar o estilo de
             TextBlock DENTRO do ComboBox. Cada ComboBox faz isso com

                 <ComboBox.Resources>
                     <Style TargetType="TextBlock" BasedOn="{StaticResource TextoEmCombo}" />
                 </ComboBox.Resources>

             e o popup da lista, que faz parte da arvore dele, pega a mesma
             regra. Nao da para embutir isso num Setter aqui: Resources e
             propriedade CLR comum, nao DependencyProperty, e Setter so aceita
             DependencyProperty. -->
        <SolidColorBrush x:Key="TextoCombo" Color="#12141A" />

        <Style x:Key="TextoEmCombo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoCombo}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextoCombo}" />
            <Setter Property="Padding"    Value="6,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextoCombo}" />
        </Style>

    </Application.Resources>
</Application>
